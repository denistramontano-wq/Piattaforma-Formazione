NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Autenticazione (Firebase) — vedi apps/api/.env.example per il lato server ---
# Valori presi da: Console Firebase → Impostazioni progetto → Generale → Le tue app (web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Lascia false (o rimuovi) per usare il progetto Firebase reale invece dell'emulatore locale.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_EMULATOR_URL=http://localhost:9099
