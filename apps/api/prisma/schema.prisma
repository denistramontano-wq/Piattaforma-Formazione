generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  EDITOR
  ADMIN
}

enum Level {
  BASE
  INTERMEDIO
  AVANZATO
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum LessonContentType {
  TEXT
  VIDEO
  PDF
}

enum FileType {
  PDF
  WORD
  EXCEL
  POWERPOINT
  IMAGE
  VIDEO
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  OPEN_TEXT
  FILL_BLANK
  DRAG_DROP
  ORDERING
  IMAGE_CHOICE
}

enum GameType {
  FLASHCARD
  MEMORY
  DRAG_DROP
  PUZZLE
  TIMED_QUIZ
  ESCAPE_ROOM
  FIND_ERROR
  IMAGE_MATCH
}

enum EnrollmentStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  /// UID Firebase Authentication collegato a questo utente. Null finché l'utente (es. seedato per demo)
  /// non ha ancora effettuato il primo accesso reale — a quel punto viene collegato per email (vedi auth.service.ts).
  firebaseUid   String?        @unique
  fullName      String
  avatarUrl     String?
  role          Role           @default(STUDENT)
  createdAt     DateTime       @default(now())
  /// Data (senza ora) dell'ultima attività registrata, per il calcolo della streak giornaliera (docs/05 §5.2)
  lastActiveDate DateTime?
  currentStreak  Int           @default(0)
  longestStreak  Int           @default(0)
  coursesAuthored Course[]     @relation("CourseAuthor")
  enrollments   Enrollment[]
  quizAttempts  QuizAttempt[]
  gameSessions  GameSession[]
  certificates  Certificate[]
  userLevel     UserLevel?
  userBadges    UserBadge[]
  xpEvents      XpEvent[]
  aiGenerationsReviewed AiGeneration[]
  chatConversations     ChatConversation[]
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  courses  Course[]   @relation("CourseCategories")
  documents Document[]
  videos   Video[]
  faqs     Faq[]
  downloads DownloadFile[]
}

model Tag {
  id      String   @id @default(uuid())
  name    String   @unique
  courses Course[] @relation("CourseTags")
}

model Course {
  id               String        @id @default(uuid())
  title            String
  slug             String        @unique
  description      String
  coverUrl         String?
  authorId         String
  author           User          @relation("CourseAuthor", fields: [authorId], references: [id])
  level            Level         @default(BASE)
  estimatedMinutes Int           @default(0)
  status           ContentStatus @default(DRAFT)
  publishAt        DateTime?
  createdAt        DateTime      @default(now())
  categories       Category[]    @relation("CourseCategories")
  tags             Tag[]         @relation("CourseTags")
  modules          Module[]
  enrollments      Enrollment[]
  certificates     Certificate[]
}

model Module {
  id         String   @id @default(uuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int
  lessons    Lesson[]
}

model Lesson {
  id               String            @id @default(uuid())
  moduleId         String
  module           Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title            String
  orderIndex       Int
  estimatedMinutes Int               @default(10)
  contentType      LessonContentType @default(TEXT)
  contentBody      String?
  videoUrl         String?
  documentId       String?
  quizzes          Quiz[]
  lessonProgress   LessonProgress[]
}

model Enrollment {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id])
  status         EnrollmentStatus @default(IN_PROGRESS)
  progressPct    Float            @default(0)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  lessonProgress LessonProgress[]

  @@unique([userId, courseId])
}

model LessonProgress {
  id               String     @id @default(uuid())
  enrollmentId     String
  enrollment       Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId         String
  lesson           Lesson     @relation(fields: [lessonId], references: [id])
  completed        Boolean    @default(false)
  timeSpentSeconds Int        @default(0)
  lastViewedAt     DateTime   @default(now())

  @@unique([enrollmentId, lessonId])
}

model Document {
  id                String             @id @default(uuid())
  title             String
  description       String?
  author            String?
  categoryId        String?
  category          Category?          @relation(fields: [categoryId], references: [id])
  level             Level              @default(BASE)
  estimatedMinutes  Int                @default(15)
  versions          DocumentVersion[]
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  fileUrl       String
  changelog     String?
  isCurrent     Boolean  @default(true)
  createdAt     DateTime @default(now())
  /// Testo estratto dal PDF all'upload, usato dal motore di ricerca full-text (docs/03-sistema-ricerca.md)
  extractedText String?
}

model Video {
  id               String   @id @default(uuid())
  title            String
  description      String?
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id])
  url              String
  durationSeconds  Int
  level            Level    @default(BASE)
}

enum QuestionMode {
  SEQUENTIAL
  RANDOM
}

model Quiz {
  id               String   @id @default(uuid())
  title            String
  description      String?
  lessonId         String?
  lesson           Lesson?  @relation(fields: [lessonId], references: [id])
  passThresholdPct Float    @default(60)
  level            Level    @default(BASE)
  /// Numero massimo di tentativi consentiti; null = illimitati (docs/04 §4.3)
  maxAttempts      Int?
  /// Tempo totale a disposizione per il tentativo, in secondi; null = nessun limite
  timeLimitSeconds Int?
  questionMode     QuestionMode @default(SEQUENTIAL)
  /// Se impostato, ad ogni tentativo vengono estratte casualmente questo numero di domande dal pool totale ("banca domande")
  bankSize         Int?
  questions        Question[]
  attempts         QuizAttempt[]
}

model Question {
  id           String       @id @default(uuid())
  quizId       String
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type         QuestionType @default(MULTIPLE_CHOICE)
  prompt       String
  payload      Json
  explanation  String?
  scoreWeight  Int          @default(1)
  difficulty   Level        @default(BASE)
  orderIndex   Int          @default(0)
  attemptAnswers QuizAttemptAnswer[]
}

model QuizAttempt {
  id          String    @id @default(uuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  /// Id e ordine delle domande estratte/presentate per questo tentativo (docs/04 §4.1 banca domande)
  questionIds Json
  scorePct    Float?
  passed      Boolean?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  answers     QuizAttemptAnswer[]
}

/// Correttezza per singola domanda in un tentativo, per l'analytics "domande più sbagliate" (docs/07 §7.2)
model QuizAttemptAnswer {
  id        String      @id @default(uuid())
  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question  Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  correct   Boolean
  createdAt DateTime    @default(now())

  @@index([questionId])
}

model MiniGame {
  id          String     @id @default(uuid())
  title       String
  description String?
  type        GameType
  difficulty  Level      @default(BASE)
  config      Json
  sessions    GameSession[]
}

model GameSession {
  id              String   @id @default(uuid())
  gameId          String
  game            MiniGame @relation(fields: [gameId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  score           Int      @default(0)
  durationSeconds Int      @default(0)
  playedAt        DateTime @default(now())
}

model DownloadFile {
  id          String    @id @default(uuid())
  title       String
  description String?
  fileType    FileType
  url         String
  sizeBytes   Int       @default(0)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
}

model Faq {
  id         String    @id @default(uuid())
  question   String
  answer     String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
}

model Certificate {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  verifyCode String   @unique
  pdfUrl     String?
  issuedAt   DateTime @default(now())
}

model UserLevel {
  userId     String @id
  user       User   @relation(fields: [userId], references: [id])
  currentLevel Int  @default(1)
  totalXp    Int    @default(0)
}

model Badge {
  id                 String      @id @default(uuid())
  /// Codice stabile usato dal badge engine per collegare il badge alla regola di assegnazione (vedi badge-engine.service.ts)
  code               String      @unique
  name               String
  criteriaDescription String?
  iconUrl            String?
  userBadges         UserBadge[]
}

model UserBadge {
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@id([userId, badgeId])
}

/// Regola punti XP per azione (docs/05 §5.2), configurabile da admin
model XpRule {
  action      String @id
  points      Int
  description String
}

/// Log delle assegnazioni XP, base per classifiche a finestra temporale e storico attività
model XpEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  points    Int
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// --- Intelligenza Artificiale (docs/06-intelligenza-artificiale.md) ---

enum AiSourceType {
  DOCUMENT
  LESSON
}

enum AiGenerationType {
  SUMMARY
  FLASHCARDS
  QUIZ
  CONCEPT_MAP
}

enum AiReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model AiGeneration {
  id             String            @id @default(uuid())
  sourceType     AiSourceType
  sourceId       String
  sourceTitle    String
  generationType AiGenerationType
  /// Output strutturato specifico per tipo (testo riassunto, array flashcard, domande quiz, nodi mappa)
  output         Json
  provider       String
  reviewStatus   AiReviewStatus    @default(PENDING)
  reviewedById   String?
  reviewedBy     User?             @relation(fields: [reviewedById], references: [id])
  /// Id dell'entità reale creata all'approvazione (Quiz.id o MiniGame.id)
  resultRefId    String?
  createdAt      DateTime          @default(now())
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatConversation {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  scopeType String        @default("global")
  scopeId   String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  /// Elenco fonti citate: [{ type, id, title, url }]
  sources        Json?
  createdAt      DateTime         @default(now())
}

model AiUsageLog {
  id           String   @id @default(uuid())
  kind         String
  provider     String
  tokensInput  Int      @default(0)
  tokensOutput Int      @default(0)
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())
}
