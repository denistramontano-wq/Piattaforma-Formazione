DATABASE_URL="postgresql://formazione:formazione@localhost:5432/formazione?schema=public"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
# URL pubblico usato per costruire i link ai file caricati in /uploads
API_PUBLIC_URL="http://localhost:3001"

# --- Autenticazione (Firebase) — vedi docs/09, modules/auth/ ---
# Id del progetto Firebase (obbligatorio sia con l'emulatore che in produzione)
FIREBASE_PROJECT_ID="demo-formazione-adl"
# Solo in sviluppo locale: fa collegare firebase-admin all'emulatore invece che a Firebase vero,
# nessuna credenziale reale necessaria. NON impostare in produzione.
FIREBASE_AUTH_EMULATOR_HOST="localhost:9099"
# Solo in produzione (rimuovere FIREBASE_AUTH_EMULATOR_HOST sopra): credenziali del service
# account, scaricabili da Firebase Console → Impostazioni progetto → Account di servizio.
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@progetto.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Email (separate da virgola) promosse automaticamente a ruolo ADMIN al primo accesso
ADMIN_EMAILS="admin@demo.piattaforma-formazione.it"

# --- Storage file caricati (manuali, video, certificati) — vedi modules/storage, DEPLOY.md ---
# Senza queste variabili i file vengono salvati su disco locale (cartella uploads/), va bene per
# lo sviluppo. In produzione su un piano gratuito (nessun disco persistente) impostale per usare
# Supabase Storage: Supabase → Project Settings → API (per URL e chiave), e crea un bucket
# pubblico chiamato "uploads" in Storage.
# SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# SUPABASE_STORAGE_BUCKET="uploads"
